{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(make check*)",
      "Bash(make fe-check*)",
      "Bash(make fe-test*)",
      "Bash(cd api && ./vendor/bin/sail test*)",
      "Bash(cd api && ./vendor/bin/sail artisan*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(coderabbit review*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)",
      "Bash(git push origin*)",
      "Bash(gh pr create*)",
      "Bash(gh project item-edit*)",
      "Bash(gh project item-list*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git diff --no-index*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(rm -rf*)",
      "Read(.env*)",
      "Read(**/.env*)"
    ]
  }
}
